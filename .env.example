# Discord Developer Portal > Application > Bot > Reset Token / Copy
DISCORD_TOKEN=HIER_DEIN_BOT_TOKEN
# Zielkanal: Discord Entwicklermodus > Rechtsklick auf Textkanal > ID kopieren
CHANNEL_ID=123456789012345678
# Optional: Server-ID, damit Slash-Commands sofort sichtbar werden
GUILD_ID=
# Wöchentliche Veröffentlichung am Montag in deutscher Zeit
POST_TIME=06:00
TIMEZONE=Europe/Berlin
# Relativ zum Ordner des Bots
NEWS_FILE=data/news.json
STATE_FILE=data/state.json
PREVIEW_FILE=data/preview.json
